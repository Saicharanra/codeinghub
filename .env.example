# Coding Hub - Environment Variables Template
# Copy this file to .env.local to configure your local development environment

# Site URL for canonical URLs, Open Graph, and sitemap generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense Configuration (Leave blank or fill with your approved Publisher ID)
# e.g. ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google AdSense Ad Slot IDs for various placements
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# Optional Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
