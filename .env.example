# ==============================================================================
# Coding Hub - Production & Development Environment Configuration
# ==============================================================================
# Copy this file to .env.local to configure your local development environment:
# cp .env.example .env.local
#
# NOTE: In production (e.g. Vercel Project Settings), configure these variables
# under Environment Variables.
# ==============================================================================

# 1. Primary Canonical Site URL
# Used for canonical URL generation, sitemap.xml, robots.txt, and OpenGraph URLs.
# In local development: http://localhost:3000
# In production: https://codinghub.dev (or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Google Search Console Site Verification (Optional)
# Enter the verification token string provided by Google Search Console
# (found in HTML tag verification method: <meta name="google-site-verification" content="TOKEN" />)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 3. Google Analytics 4 (Optional)
# Your Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Analytics scripts are privacy-conscious and ONLY execute after the user grants consent.
# Leave blank to disable analytics completely.
NEXT_PUBLIC_GA_ID=

# 4. Google AdSense Publisher ID (Optional)
# Your approved Google AdSense publisher account ID (format: ca-pub-XXXXXXXXXXXXXXXX).
# Ad scripts and slots will strictly collapse without rendering if this is left blank.
NEXT_PUBLIC_ADSENSE_CLIENT=

# 5. Google AdSense Slot Placements (Optional)
# Numeric Slot IDs generated in your Google AdSense dashboard under "Ad units":
# - HEADER: Responsive leaderboard/banner displayed below page headers
# - CONTENT: In-article/mid-tool responsive unit
# - FOOTER: Bottom responsive display unit placed above the website footer
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
